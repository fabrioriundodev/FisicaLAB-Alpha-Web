---
import { Link } from "accessible-astro-components";
import { Icon } from "astro-icon/components";

export interface DropdownProps {
  label: string;
  items: { href: string; label: string; target?: string }[];
}
type Item = DropdownProps["items"][number];

const { label, items } = Astro.props;
---

<li class="menu-item has-dropdown group relative">
  <button
    aria-haspopup="true"
    aria-expanded="false"
    class="flex items-center gap-2 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
  >
    {label}
    <Icon aria-hidden="true" name="lucide:chevron-down" size="20" />
  </button>

  <ul class="dropdown-menu">
{items.map((item: Item) => (
  <li class="submenu-item">
    <Link
      href={item.href}
      target={item.target ?? "_self"}
      rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
    >
      {item.label}
    </Link>
  </li>
))}

  </ul>
</li>
